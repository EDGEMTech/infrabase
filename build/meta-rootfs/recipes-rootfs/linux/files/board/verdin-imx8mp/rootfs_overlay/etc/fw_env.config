# Configuration file for fw_(printenv/setenv).
#
# U-Boot on Verdin iMX8MP stores its environment at the end of the first eMMC
# boot hardware partition (CONFIG_SYS_MMC_ENV_DEV=2, CONFIG_SYS_MMC_ENV_PART=1,
# CONFIG_ENV_OFFSET=0xFFFFDE00 => -0x2200, CONFIG_ENV_SIZE=0x2000). The env sits
# just in front of the Toradex config block in the last sector (hence -0x2200).
#
# This must match the Torizon capsule's /etc/fw_env.config so the FC and the
# capsule read/write the SAME environment. Toradex uses the /dev/emmc-boot0
# udev symlink there; buildroot has no such rule, so use the real node.
#
# mmcblk2boot0 is read-only by default; libubootenv's fw_setenv clears
# /sys/block/mmcblk2boot0/force_ro automatically before writing.

# Block device name	Device offset	Env. size
/dev/mmcblk2boot0	-0x2200		0x2000
