+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/*
+ * Copyright 2022 Toradex
+ */
+
+// Apalis iMX8 spidev
+
+/dts-v1/;
+/plugin/;
+
+/ {
+	compatible = "toradex,apalis-imx8", "toradex,apalis-imx8-v1.1";
+};
+
+/* Apalis SPI2 */
+&lpspi2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	spidev@0 {
+		/* Use compatible "rohm,dh2228fv" to bind spidev driver */
+		compatible = "rohm,dh2228fv";
+		reg = <0>;
+	};
+};
