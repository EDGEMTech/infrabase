+#define C73_NEXT_PAGE_TOGGLE			BIT(11)
+#define C73_NEXT_PAGE_ACK2			BIT(12)
+#define C73_NEXT_PAGE_MP			BIT(13)
+#define C73_NEXT_PAGE_ACK			BIT(14)
+#define C73_NEXT_PAGE_NP			BIT(15)
