--- /home/rossierd/edgemtech/products/edgem1/edgem1/30/build/tmp/work/linux-6.6-verdin-r0/linux-6.6-verdin/arch/arm64/boot/dts/freescale/imx93-14x14-evk-dsi-serdes.dts	1970-01-01 01:00:00.000000000 +0100
