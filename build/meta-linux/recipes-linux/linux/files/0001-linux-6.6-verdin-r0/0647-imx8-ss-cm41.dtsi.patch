--- /home/rossierd/edgemtech/products/edgem1/edgem1/30/build/tmp/work/linux-6.6-verdin-r0/linux-6.6-verdin/arch/arm64/boot/dts/freescale/imx8-ss-cm41.dtsi	1970-01-01 01:00:00.000000000 +0100
+++ ./arch/arm64/boot/dts/freescale/imx8-ss-cm41.dtsi	2026-04-08 16:21:01.993930915 +0200
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0+
