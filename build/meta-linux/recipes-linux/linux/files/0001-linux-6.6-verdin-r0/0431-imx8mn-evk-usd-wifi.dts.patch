--- /home/rossierd/edgemtech/products/edgem1/edgem1/30/build/tmp/work/linux-6.6-verdin-r0/linux-6.6-verdin/arch/arm64/boot/dts/freescale/imx8mn-evk-usd-wifi.dts	1970-01-01 01:00:00.000000000 +0100
+++ ./arch/arm64/boot/dts/freescale/imx8mn-evk-usd-wifi.dts	2026-04-08 16:21:02.023031150 +0200
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright 2022 NXP
+ */
+
+/dts-v1/;
+
+#include "imx8mn-evk.dts"
+
+/*
+ * IW612 wifi chip needs more delay than other wifi chips to complete the host
+ * interface initialization after power up, otherwise the internal state of
+ * IW612 may be unstable, resulting in the failure of the SDIO3.0 switch
+ * voltage.
+ */
+&reg_usdhc2_vmmc {
+	startup-delay-us = <20000>;
+};
+
+&usdhc2 {
+	pinctrl-0 = <&pinctrl_usdhc2>;
+	pinctrl-1 = <&pinctrl_usdhc2_100mhz>;
+	pinctrl-2 = <&pinctrl_usdhc2_200mhz>;
+	/delete-property/ cd-gpios;
+	keep-power-in-suspend;
+	non-removable;
+	wakeup-source;
+};
+
+&usdhc1 {
+	status = "disabled";
+	/delete-node/ wifi_wake_host;
+};
