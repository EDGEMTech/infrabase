 	  The driver manages network objects discovered on the Freescale
 	  MC bus.
 
+config FSL_DPAA2_MAC
+	tristate "Freescale DPAA2 MAC driver"
+	depends on FSL_MC_BUS
+	select FSL_XGMAC_MDIO
+	select PHYLINK
+	select PCS_LYNX
+	help
