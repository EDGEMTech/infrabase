--- /home/rossierd/edgemtech/products/edgem1/edgem1/30/build/tmp/work/linux-6.6-verdin-r0/linux-6.6-verdin/drivers/net/ethernet/freescale/dpaa2/Kconfig	2026-04-08 18:20:08.149261516 +0200
+++ ./drivers/net/ethernet/freescale/dpaa2/Kconfig	2026-04-08 16:21:07.513302189 +0200
