 	bool "Data Center Bridging (DCB) Support"
@@ -20,6 +41,13 @@
 	help
 	  Enable Priority-Based Flow Control (PFC) support for DPAA2 Ethernet
 	  devices.
+
+config FSL_DPAA2_ETH_CEETM
+	depends on NET_SCHED
+	bool "DPAA2 Ethernet CEETM QoS"
+	default n
+	help
