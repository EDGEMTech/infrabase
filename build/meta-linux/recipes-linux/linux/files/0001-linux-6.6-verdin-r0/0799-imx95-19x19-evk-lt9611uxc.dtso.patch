--- /home/rossierd/edgemtech/products/edgem1/edgem1/30/build/tmp/work/linux-6.6-verdin-r0/linux-6.6-verdin/arch/arm64/boot/dts/freescale/imx95-19x19-evk-lt9611uxc.dtso	1970-01-01 01:00:00.000000000 +0100
+++ ./arch/arm64/boot/dts/freescale/imx95-19x19-evk-lt9611uxc.dtso	2026-04-08 16:21:02.102732833 +0200
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2024 NXP
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include "imx95-lt9611uxc-common.dtsi"
+
+&lpi2c2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	hdmi@2b {
+		compatible = "lontium,lt9611uxc";
+		reg = <0x2b>;
+		reset-gpios = <&adp5585gpio 4 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&gpio3 27 IRQ_TYPE_EDGE_FALLING>;
+
+		vdd-supply = <&reg_1p8v>;
+		vcc-supply = <&reg_3p3v>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_mipi_dsi_csi>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				lt9611uxc_to_dsi: endpoint {
+					remote-endpoint = <&dsi_to_lt9611uxc>;
+				};
+			};
+
+			port@2 {
+				reg = <2>;
+
+				lt9611uxc_out: endpoint {
+					remote-endpoint = <&hdmi_lt9611uxc_in>;
+				};
+			};
+		};
+	};
+};
