--- /home/rossierd/edgemtech/products/edgem1/edgem1/30/build/tmp/work/linux-6.6-verdin-r0/linux-6.6-verdin/arch/arm/boot/dts/nxp/imx/imx6sll-evk-btwifi.dts	1970-01-01 01:00:00.000000000 +0100
+++ ./arch/arm/boot/dts/nxp/imx/imx6sll-evk-btwifi.dts	2026-04-08 16:21:00.861060001 +0200
@@ -0,0 +1,66 @@
+/*
