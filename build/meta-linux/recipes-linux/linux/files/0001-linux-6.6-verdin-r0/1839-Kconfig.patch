+config DRM_CDNS_AUDIO
+	tristate "Cadence MHDP Audio driver"
+	depends on DRM_CDNS_MHDP
+
+config DRM_CDNS_HDCP
+	tristate "Cadence HDMI/DP HDCP driver"
+	depends on DRM_CDNS_MHDP
+	help
