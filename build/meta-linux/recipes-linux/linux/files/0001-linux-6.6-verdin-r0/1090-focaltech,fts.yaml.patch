+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/focaltech,fts.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: FocalTech series touchScreen controller
+
+maintainers:
+  - Carlos Song <carlos.song@nxp.com>
+
+allOf:
+  - $ref: touchscreen.yaml#
+
+properties:
+  compatible:
+    const: focaltech,fts
+  reg:
+    const: 0x38
+  irq-gpio:
+    maxItems: 1
+  max-touch-number:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: max number of fingers supported
+    minimum: 2
+    maximum: 10
+  touchscreen-size-x: true
+  touchscreen-size-y: true
+
+additionalProperties: false
+
+required:
+  - compatible
+  - reg
+  - irq-gpio
+  - max-touch-number
+  - touchscreen-size-x
+  - touchscreen-size-y
+
+examples:
+  - |
+    &i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+      clock-frequency = <400000>;
+
+      focaltech_touch: touchscreen@38 {
+        compatible = "focaltech,fts";
+        reg = <0x38>;
+        irq-gpio = <&gpio3 27 GPIO_ACTIVE_HIGH>;
+        touchscreen-size-x = <1080>;
+        touchscreen-size-y = <1920>;
+        max-touch-number = <10>;
+      };
+    };
\ No newline at end of file
