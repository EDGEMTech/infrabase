--- /home/rossierd/edgemtech/products/edgem1/edgem1/30/build/tmp/work/linux-6.6-verdin-r0/linux-6.6-verdin/Documentation/devicetree/bindings/media/nxp,neoisp.yaml	1970-01-01 01:00:00.000000000 +0100
+++ ./Documentation/devicetree/bindings/media/nxp,neoisp.yaml	2026-04-08 16:20:51.441447756 +0200
