+{
+	struct arm_smccc_res res;
+
+	if (!err11171)
+		return;
+
+	/* now call into EL3 and take care of the wakeup */
+	arm_smccc_smc(FSL_SIP_GPC, FSL_SIP_CONFIG_GPC_CORE_WAKE,
+			*cpumask_bits(mask), 0, 0, 0, 0, 0, &res);
