 * along with this program; if not, write to the Free Software
 * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
 *
 */

/dts-v1/;

/ {
	description = "AVZ Hypervisor bundle for the Toradex Verdin iMX8MP";

	images {

		avz {
			description = "AVZ Hypervisor (64-bit) Polymorphic SO3";
			data = /incbin/("${IB_AVZ_PATH}/so3.bin");
			type = "kernel";
			os = "linux";
			arch = "arm64";
			compression = "none";
			load = <0x40080000>;
			entry = <0x40080000>;
		};

		avz_dt {
			description = "AVZ flattened device tree blob";
			data = /incbin/("${IB_AVZ_PATH}/dts/verdin-imx8mp_avz.dtb");
			type = "avz_dt";
			arch = "arm64";
			compression = "none";
			load = <0x46000000>;
		};
	};

	configurations {
		default = "avz";

		avz {
			description = "AVZ hypervisor on Verdin iMX8MP";
			kernel = "avz";
			loadables = "avz_dt";
			fdt = "avz_dt";
		};
	};
};
