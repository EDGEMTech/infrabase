/*
 * Copyright (C) 2020-2026 EDGEMTech SA <info@edgemtech.ch>
 *
 * Bare Linux ITS for the Toradex Verdin iMX8MP. Single ITB carrying
 * kernel + DTB + initrd, bootm'd directly by U-Boot. No AVZ: this is
 * the IB_HYPERVISOR="none" shape, on either of the two firmware chains
 * the iMX8MP supports ("atf+uboot" or "atf+optee+uboot") — the SoC boot
 * ROM always needs BL31, so there is no bare-U-Boot variant here.
 *
 * Template: ${IB_*_PATH} placeholders are expanded to absolute build
 * paths by bsp_render_its (bsp.bbclass) at do_itb time.
 *
 * The AVZ path uses verdin-imx8mp_avz.its + verdin-imx8mp_linux_guest.its
 * instead — see those files for the two-ITB guest-boot variant.
 *
 * This program is free software; you can redistribute it and/or modify
 * it under the terms of the GNU General Public License version 2 as
 * published by the Free Software Foundation.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 * GNU General Public License for more details.
 *
 * You should have received a copy of the GNU General Public License
 * along with this program; if not, write to the Free Software
 * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
 *
 */

/dts-v1/;

/ {
	description = "Kernel and rootfs components for verdin-imx8mp (arm64) environment";

	images {

		linux {
			description = "Linux kernel";
			data = /incbin/("${IB_LINUX_PATH}/arch/arm64/boot/Image");
			type = "kernel";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x40400000>;
			entry = <0x40400000>;
		};

		fdt_linux {
			description = "Linux device tree blob";
			data = /incbin/("${IB_LINUX_PATH}/arch/arm64/boot/dts/freescale/imx8mp-verdin-wifi-mallow.dtb");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			load = <0x50200000>;
		};

		initrd {
			description = "Initial rootfs (initramfs)";
			data = /incbin/("${IB_ROOTFS_PATH}/board/${IB_PLATFORM}/initrd.cpio.gz");
			type = "ramdisk";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x50300000>;
		};
	};

	configurations {
		default = "conf_linux";

		conf_linux {
			description = "Linux on Verdin iMX8MP";
			kernel = "linux";
			fdt = "fdt_linux";
			ramdisk = "initrd";
		};
	};
};
